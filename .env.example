# Copy to .env and fill in. NEVER commit .env.
# --- Supabase (service_role stays server-side; dashboard uses anon key) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres (migrations/seeds/pg_dump only — never used by the app runtime)
SUPABASE_DB_URL=
# --- LLM: generation only via OpenRouter ---
OPENROUTER_API_KEY=
# Ordered model list wins when set. Defaults below reflect live verification
# (Oct 2026): Nemotron :free works from plain API calls; Inkling :free is
# gated by OpenRouter to approved agentic harnesses (403) and serves as fallback.
OPENROUTER_MODELS=
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=thinkingmachines/inkling:free
# --- Triage: Inception Labs DIRECT api (not OpenRouter) ---
INCEPTION_API_KEY=
TRIAGE_THRESHOLD=0.75
MAYBE_MIN=0.5
# --- De-slop gate (hold drafts scoring above this) ---
DESLOP_GATE=0.5
# --- Discovery ---
TINYFISH_API_KEY=
REDDIT_MCP_URL=http://127.0.0.1:3001
# Reddit burner OAuth (read-only script app, throwaway account — never your main)
# Optional upgrade: until Reddit approves API access (Responsible Builder
# gate), discovery runs on no-auth RSS automatically (REDDIT_SOURCE=auto).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# auto = oauth if creds present else rss · rss = force no-auth RSS · oauth = force (fails without creds)
REDDIT_SOURCE=auto
# Min spacing between Reddit RSS requests (ms). Reddit throttles per-IP;
# below ~25s you get empty feeds. 45000 default. Max 25 subreddits per run.
REDDIT_RSS_MIN_INTERVAL_MS=45000
REDDIT_RSS_MAX_SUBS=10
# --- Infra ---
REDIS_URL=redis://localhost:6379
PORT=3000
SITE_HOST=yourname.duckdns.org
DASHBOARD_USER=owner
DASHBOARD_HASH=
